---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/pages', label: 'Pages' },
  { href: '/admin/events', label: 'Events' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — Admin — Agent Playground</title>
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="border-b border-slate-200 dark:border-slate-800">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-4">
        <p class="text-lg font-semibold">Agent Playground · Admin</p>
        <nav aria-label="Admin sections">
          <ul class="flex gap-4">
            {
              navItems.map((item) => {
                const isCurrent = currentPath === item.href;
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isCurrent ? 'page' : undefined}
                      class:list={[
                        'underline-offset-4 hover:underline',
                        isCurrent && 'font-semibold underline',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
            <li><a href="/" class="underline-offset-4 hover:underline">Public site</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" class="mx-auto max-w-5xl px-4 py-8">
      <h1 class="mb-6 text-2xl font-bold">{title}</h1>
      <slot />
    </main>
  </body>
</html>
