---
import '../styles/global.css';
import { getCartView } from '../lib/webshop/cart-server';

export interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: Breadcrumb[];
}

const { title, description, breadcrumbs = [] } = Astro.props;
const year = new Date().getFullYear();

const cart = getCartView(Astro.locals.cartId);
const cartCount = cart.itemCount;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title} — Demo Shop — Agent Playground</title>
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="border-b border-slate-200 dark:border-slate-800" style="background-color: aquamarine;">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a href="/shop" class="flex items-center gap-2 text-lg font-semibold">
          <span aria-hidden="true">🛍️</span>
          Demo Shop
        </a>
        <nav aria-label="Shop">
          <ul class="flex items-center gap-4">
            <li><a href="/shop" class="underline-offset-4 hover:underline">Products</a></li>
            <li>
              <a href="/shop/cart" class="underline-offset-4 hover:underline">
                Cart
                <span
                  class="ml-1 inline-flex min-w-[1.5rem] justify-center rounded-full bg-slate-900 px-2 py-0.5 text-sm font-semibold text-white dark:bg-slate-100 dark:text-slate-900"
                >{cartCount}</span>
                <span class="sr-only">{cartCount === 1 ? 'item' : 'items'} in cart</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-4 pt-2">
      <a href="/" class="text-sm text-slate-600 underline-offset-4 hover:underline dark:text-slate-400">
        &larr; Switch to Playground
      </a>
    </div>

    {
      breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mx-auto max-w-4xl px-4 pt-4">
          <ol class="flex flex-wrap gap-2 text-sm text-slate-600 dark:text-slate-400">
            {breadcrumbs.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {crumb.href ? (
                  <a href={crumb.href} class="underline-offset-4 hover:underline">
                    {crumb.label}
                  </a>
                ) : (
                  <span aria-current="page" class="font-medium text-slate-900 dark:text-slate-100">
                    {crumb.label}
                  </span>
                )}
                {index < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="main-content" class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 dark:border-slate-800">
      <div class="mx-auto max-w-4xl px-4 py-6 text-sm text-slate-600 dark:text-slate-400">
        <p>
          Demo Shop · {year} · A fake, accessible multi-page shop for agent testing. No real
          products, orders, or payments.
        </p>
      </div>
    </footer>
  </body>
</html>
