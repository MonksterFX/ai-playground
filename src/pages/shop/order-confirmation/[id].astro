---
import ShopLayout from '../../../layouts/ShopLayout.astro';
import { getOrderById } from '../../../lib/db/repo';
import { formatPrice } from '../../../lib/webshop/catalog';

const { id } = Astro.params;
const order = id ? getOrderById(id) : undefined;

if (!order) {
  return new Response(null, {
    status: 404,
    headers: { Location: '/shop' },
  });
}

interface OrderItem {
  productId: string;
  name: string;
  qty: number;
  priceInCents: number;
  lineTotalInCents: number;
}

let items: OrderItem[] = [];
try {
  items = JSON.parse(order.itemsJson) as OrderItem[];
} catch {
  items = [];
}

const orderNumber = order.id.slice(0, 8).toUpperCase();
---

<ShopLayout
  title="Order confirmed"
  description="Your demo order has been placed."
  breadcrumbs={[{ label: 'Shop', href: '/shop' }, { label: 'Order confirmation' }]}
>
  <div
    role="status"
    class="rounded-lg border border-green-600 bg-green-50 p-6 text-green-900 dark:bg-green-950 dark:text-green-100"
  >
    <h1 class="text-2xl font-bold">Thank you — your order is confirmed</h1>
    <p class="mt-2">
      Order number <strong>#{orderNumber}</strong>. This is a demo order; nothing will actually be
      shipped and no payment was taken.
    </p>
  </div>

  <section aria-labelledby="items-heading" class="mt-8">
    <h2 id="items-heading" class="text-xl font-semibold">Order details</h2>
    <table class="mt-4 w-full border-collapse text-left">
      <caption class="sr-only">Items in order #{orderNumber}</caption>
      <thead>
        <tr class="border-b border-slate-300 dark:border-slate-700">
          <th scope="col" class="py-2 pr-4">Product</th>
          <th scope="col" class="py-2 pr-4">Quantity</th>
          <th scope="col" class="py-2">Line total</th>
        </tr>
      </thead>
      <tbody>
        {
          items.map((item) => (
            <tr class="border-b border-slate-200 dark:border-slate-800">
              <th scope="row" class="py-3 pr-4 font-medium">{item.name}</th>
              <td class="py-3 pr-4">{item.qty}</td>
              <td class="py-3">{formatPrice(item.lineTotalInCents)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <dl class="mt-6 ml-auto max-w-sm space-y-2">
      <div class="flex justify-between">
        <dt>Subtotal</dt>
        <dd>{formatPrice(order.subtotalInCents)}</dd>
      </div>
      <div class="flex justify-between">
        <dt>Shipping</dt>
        <dd>{formatPrice(order.shippingInCents)}</dd>
      </div>
      <div class="flex justify-between border-t border-slate-200 pt-2 text-lg font-bold dark:border-slate-800">
        <dt>Total</dt>
        <dd>{formatPrice(order.totalInCents)}</dd>
      </div>
    </dl>
  </section>

  <p class="mt-8">
    <a href="/shop" class="underline underline-offset-4">← Continue shopping</a>
  </p>
</ShopLayout>
