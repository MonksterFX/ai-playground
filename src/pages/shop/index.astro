---
import ShopLayout from '../../layouts/ShopLayout.astro';
import { getAllProducts, formatPrice } from '../../lib/webshop/catalog';

const products = getAllProducts();
const justAdded = Astro.url.searchParams.get('added');
const addedProduct = justAdded ? products.find((p) => p.id === justAdded) : undefined;
---

<ShopLayout
  title="Products"
  description="Browse the demo shop's fake product catalog."
  breadcrumbs={[{ label: 'Home' }]}
>
  <h1 class="text-3xl font-bold">Products</h1>
  <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">
    A fake product catalog for testing agent shopping flows. Add items to your cart and walk
    through a complete checkout. Nothing here is real.
  </p>

  {
    addedProduct && (
      <div
        role="status"
        class="mt-6 rounded-lg border border-green-600 bg-green-50 p-4 text-green-900 dark:bg-green-950 dark:text-green-100"
      >
        <p>
          Added <strong>{addedProduct.name}</strong> to your cart.{' '}
          <a href="/shop/cart" class="font-semibold underline underline-offset-4">
            View cart
          </a>
          .
        </p>
      </div>
    )
  }

  <section aria-labelledby="products-heading" class="mt-10">
    <h2 id="products-heading" class="sr-only">Product list</h2>
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        products.map((product) => (
          <li class="flex flex-col rounded-lg border border-slate-200 p-5 dark:border-slate-800">
            <span
              class="text-5xl"
              aria-hidden="true"
            >
              {product.emoji}
            </span>
            <h3 class="mt-3 text-lg font-semibold">
              <a href={`/shop/products/${product.id}`} class="underline-offset-4 hover:underline">
                {product.name}
              </a>
            </h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              {product.shortDescription}
            </p>
            <p class="mt-3 text-lg font-bold">{formatPrice(product.priceInCents)}</p>
            <form method="POST" action="/shop/cart/add" class="mt-4">
              <input type="hidden" name="productId" value={product.id} />
              <input type="hidden" name="redirectTo" value="/shop" />
              <button
                type="submit"
                class="w-full rounded bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300"
              >
                Add to cart<span class="sr-only"> — {product.name}</span>
              </button>
            </form>
          </li>
        ))
      }
    </ul>
  </section>
</ShopLayout>
