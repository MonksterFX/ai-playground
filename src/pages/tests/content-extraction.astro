---
import BaseLayout from '../../layouts/BaseLayout.astro';

const orders = [
  { id: 'A-1001', product: 'Keyboard', quantity: 2, total: 118 },
  { id: 'A-1002', product: 'Monitor', quantity: 1, total: 240 },
  { id: 'A-1003', product: 'Mouse', quantity: 3, total: 75 },
  { id: 'A-1004', product: 'Webcam', quantity: 1, total: 89 },
];
const grandTotal = orders.reduce((sum, order) => sum + order.total, 0);
---

<BaseLayout
  title="Content Extraction Test"
  description="Structured content for testing information extraction by agents."
>
  <h1 class="text-2xl font-bold">Content Extraction Test</h1>
  <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">
    This page tests whether an agent can find and extract specific structured
    information from headings, lists, and tables.
  </p>

  <section aria-labelledby="facts-heading" class="mt-8">
    <h2 id="facts-heading" class="text-lg font-semibold">Key facts</h2>
    <dl class="mt-3 space-y-2">
      <div class="flex gap-2">
        <dt class="font-medium">Support email:</dt>
        <dd>support@agent-playground.test</dd>
      </div>
      <div class="flex gap-2">
        <dt class="font-medium">Reference code:</dt>
        <dd><code>APX-2026-0042</code></dd>
      </div>
      <div class="flex gap-2">
        <dt class="font-medium">Status:</dt>
        <dd>Active</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="steps-heading" class="mt-10">
    <h2 id="steps-heading" class="text-lg font-semibold">Setup steps</h2>
    <ol class="mt-3 list-decimal space-y-1 pl-6">
      <li>Create an account.</li>
      <li>Verify your email address.</li>
      <li>Add your first test page.</li>
      <li>Review the recorded events in the admin area.</li>
    </ol>
  </section>

  <section aria-labelledby="orders-heading" class="mt-10">
    <h2 id="orders-heading" class="text-lg font-semibold">Order summary</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <caption class="text-left text-sm text-slate-600 dark:text-slate-400">
          Sample orders with quantities and totals in US dollars.
        </caption>
        <thead>
          <tr class="border-b border-slate-300 dark:border-slate-700">
            <th scope="col" id="col-id" class="py-2 pr-4">Order ID</th>
            <th scope="col" id="col-product" class="py-2 pr-4">Product</th>
            <th scope="col" id="col-qty" class="py-2 pr-4">Quantity</th>
            <th scope="col" id="col-total" class="py-2 pr-4">Total (USD)</th>
          </tr>
        </thead>
        <tbody>
          {
            orders.map((order) => (
              <tr class="border-b border-slate-200 dark:border-slate-800">
                <th scope="row" id={`row-${order.id}`} headers="col-id" class="py-2 pr-4 font-normal">
                  {order.id}
                </th>
                <td headers={`col-product row-${order.id}`} class="py-2 pr-4">
                  {order.product}
                </td>
                <td headers={`col-qty row-${order.id}`} class="py-2 pr-4">
                  {order.quantity}
                </td>
                <td headers={`col-total row-${order.id}`} class="py-2 pr-4">
                  ${order.total}
                </td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-slate-400 dark:border-slate-600 font-semibold">
            <th scope="row" id="foot-label" colspan="3" class="py-2 pr-4 text-right">
              Grand total
            </th>
            <td headers="col-total foot-label" class="py-2 pr-4">${grandTotal}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>
</BaseLayout>
