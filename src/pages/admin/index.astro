---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDashboardStats, recordEvent } from '../../lib/db/repo';
import { testPages } from '../../lib/pages/registry';

const mcpTestPages = testPages.filter((p) => p.id.startsWith('webmcp-'));

recordEvent({
  eventType: 'admin_view',
  path: Astro.url.pathname,
  url: Astro.url.href,
  method: 'GET',
  statusCode: 200,
  requestId: Astro.locals.requestId,
  metadata: { view: 'dashboard' },
});

const stats = getDashboardStats();

const cards = [
  { label: 'Total pages', value: stats.totalPages },
  { label: 'Enabled pages', value: stats.enabledPages },
  { label: 'Disabled pages', value: stats.disabledPages },
  { label: 'Events (24h)', value: stats.recentEventCount },
  { label: 'Errors (24h)', value: stats.recentErrorCount },
];
---

<AdminLayout title="Dashboard">
  <section aria-labelledby="overview-heading">
    <h2 id="overview-heading" class="sr-only">Overview</h2>
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {
        cards.map((card) => (
          <li class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
            <p class="text-sm text-slate-600 dark:text-slate-400">{card.label}</p>
            <p class="mt-1 text-2xl font-bold">{card.value}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="slowest-heading" class="mt-10">
    <h2 id="slowest-heading" class="text-lg font-semibold">Slowest recent responses (24h)</h2>
    {
      stats.slowestResponses.length === 0 ? (
        <p class="mt-3 text-slate-600 dark:text-slate-400">No recent responses recorded yet.</p>
      ) : (
        <div class="mt-3 overflow-x-auto">
          <table class="w-full border-collapse text-left text-sm">
            <caption class="sr-only">The five slowest responses in the last 24 hours.</caption>
            <thead>
              <tr class="border-b border-slate-300 dark:border-slate-700">
                <th scope="col" class="py-2 pr-4">Timestamp</th>
                <th scope="col" class="py-2 pr-4">Path</th>
                <th scope="col" class="py-2 pr-4">Status</th>
                <th scope="col" class="py-2 pr-4">Response time</th>
              </tr>
            </thead>
            <tbody>
              {stats.slowestResponses.map((event) => (
                <tr class="border-b border-slate-200 dark:border-slate-800">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(event.timestamp).toLocaleString()}
                  </td>
                  <td class="py-2 pr-4">{event.path}</td>
                  <td class="py-2 pr-4">{event.statusCode}</td>
                  <td class="py-2 pr-4">{event.responseTimeMs} ms</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section aria-labelledby="mcp-tests-heading" class="mt-10">
    <h2 id="mcp-tests-heading" class="text-lg font-semibold">MCP test pages</h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        mcpTestPages.map((page) => (
          <li class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
            <h3 class="font-medium">
              <a href={page.path} class="underline-offset-4 hover:underline">
                {page.title}
              </a>
            </h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{page.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="mt-8">
    <a href="/admin/events" class="underline underline-offset-4">View all recent events</a>
  </p>
</AdminLayout>
