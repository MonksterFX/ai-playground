---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listRecentEvents, recordEvent } from '../../lib/db/repo';

recordEvent({
  eventType: 'admin_view',
  path: Astro.url.pathname,
  url: Astro.url.href,
  method: 'GET',
  statusCode: 200,
  requestId: Astro.locals.requestId,
  metadata: { view: 'events' },
});

const events = listRecentEvents(200);

function summarizeUserAgent(ua: string | null): string {
  if (!ua) return '—';
  return ua.length > 60 ? `${ua.slice(0, 57)}…` : ua;
}

function prettyJson(value: string | null): string | null {
  if (!value) return null;
  try {
    return JSON.stringify(JSON.parse(value), null, 2);
  } catch {
    return value;
  }
}
---

<AdminLayout title="Events">
  <p class="mb-4 text-slate-700 dark:text-slate-300">
    The {events.length} most recent events, newest first.
  </p>

  {
    events.length === 0 ? (
      <p class="text-slate-600 dark:text-slate-400">No events recorded yet.</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">Recent tracking events in reverse chronological order.</caption>
          <thead>
            <tr class="border-b border-slate-300 dark:border-slate-700">
              <th scope="col" class="py-2 pr-3">Timestamp</th>
              <th scope="col" class="py-2 pr-3">Event</th>
              <th scope="col" class="py-2 pr-3">Path</th>
              <th scope="col" class="py-2 pr-3">Status</th>
              <th scope="col" class="py-2 pr-3">Time</th>
              <th scope="col" class="py-2 pr-3">Agent hint</th>
              <th scope="col" class="py-2 pr-3">IP</th>
              <th scope="col" class="py-2 pr-3">User agent</th>
              <th scope="col" class="py-2 pr-3">Details</th>
            </tr>
          </thead>
          <tbody>
            {events.map((event) => {
              const headers = prettyJson(event.headersJson);
              const metadata = prettyJson(event.metadataJson);
              return (
                <tr class="border-b border-slate-200 align-top dark:border-slate-800">
                  <td class="py-2 pr-3 whitespace-nowrap">
                    {new Date(event.timestamp).toLocaleString()}
                  </td>
                  <td class="py-2 pr-3 whitespace-nowrap">{event.eventType}</td>
                  <td class="py-2 pr-3">{event.path ?? '—'}</td>
                  <td class="py-2 pr-3">{event.statusCode ?? '—'}</td>
                  <td class="py-2 pr-3 whitespace-nowrap">
                    {event.responseTimeMs != null ? `${event.responseTimeMs} ms` : '—'}
                  </td>
                  <td class="py-2 pr-3">{event.agentHint ?? '—'}</td>
                  <td class="py-2 pr-3">{event.ipAddress ?? '—'}</td>
                  <td class="py-2 pr-3">
                    <span title={event.userAgent ?? undefined}>
                      {summarizeUserAgent(event.userAgent)}
                    </span>
                  </td>
                  <td class="py-2 pr-3">
                    {headers || metadata ? (
                      <details>
                        <summary class="cursor-pointer underline underline-offset-4">
                          View
                        </summary>
                        {headers && (
                          <>
                            <p class="mt-2 font-semibold">Headers</p>
                            <pre class="overflow-x-auto rounded bg-slate-100 p-2 text-xs dark:bg-slate-900">{headers}</pre>
                          </>
                        )}
                        {metadata && (
                          <>
                            <p class="mt-2 font-semibold">Metadata</p>
                            <pre class="overflow-x-auto rounded bg-slate-100 p-2 text-xs dark:bg-slate-900">{metadata}</pre>
                          </>
                        )}
                      </details>
                    ) : (
                      '—'
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
