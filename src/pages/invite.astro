---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  isInviteGateEnabled,
  isInviteGateMisconfigured,
  safeRedirectTarget,
} from "../lib/invite";

const next = safeRedirectTarget(Astro.url.searchParams.get("next"), "/");
const error = Astro.url.searchParams.get("error");
const gateEnabled = isInviteGateEnabled();
const misconfigured = isInviteGateMisconfigured();
---

<BaseLayout
  title="Invite Required"
  description="Access to this site is restricted. Enter a valid invite code to continue."
>
  <section
    class="mx-auto flex min-h-[65vh] w-full max-w-2xl flex-col items-center justify-center text-center"
  >
    <img
      src="/logo.png"
      alt="Agent Playground logo"
      width="112"
      height="112"
      class="h-28 w-28"
    />

    <h1 class="mt-6 text-3xl font-bold">Invite code required</h1>
    <p class="mt-1 mb-2 max-w-2xl text-slate-700 dark:text-slate-300">
      This site is currently private. Enter your invite code to continue.
    </p>

    {
      gateEnabled && misconfigured && (
        <div
          role="alert"
          class="mt-6 w-full max-w-xl rounded-lg border border-amber-600 bg-amber-50 p-4 text-center text-amber-950 dark:bg-amber-950 dark:text-amber-100"
        >
          <h2 class="text-lg font-semibold">Invite gate is misconfigured</h2>
          <p class="mt-2">
            Set INVITE_CODES (comma-separated) or disable INVITE_GATE_ENABLED to
            restore access.
          </p>
        </div>
      )
    }

    {
      gateEnabled && !misconfigured && (
        <form
          method="POST"
          action="/invite/enter"
          class="w-full max-w-md space-y-5 text-center"
        >
          <input type="hidden" name="next" value={next} />
          <div>
            <div class="mt-1 flex flex-col gap-2 sm:flex-row sm:items-stretch">
              <input
                id="invite-code"
                name="inviteCode"
                type="password"
                required
                autocomplete="one-time-code"
                class="w-full flex-1 rounded border border-slate-400 px-3 py-2 text-center dark:bg-slate-900"
              />

              <button
                type="submit"
                class="rounded bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-700 sm:whitespace-nowrap dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300"
              >
                Enter site
              </button>
            </div>
          </div>

          {error === "invalid" && (
            <div
              role="alert"
              class="rounded-lg border border-red-600 bg-red-50 p-4 text-red-900 dark:bg-red-950 dark:text-red-100"
            >
              <p class="font-semibold">Invalid invite code.</p>
              <p class="mt-1">Check the code and try again.</p>
            </div>
          )}
        </form>
      )
    }

    {
      !gateEnabled && (
        <div
          role="status"
          class="mt-6 w-full max-w-xl rounded-lg border border-blue-600 bg-blue-50 p-4 text-center text-blue-950 dark:bg-blue-950 dark:text-blue-100"
        >
          <p class="font-semibold">Invite gate is disabled.</p>
          <p class="mt-1">
            Access restriction is currently turned off. You can continue to the
            site.
          </p>
          <p class="mt-3">
            <a
              href={next}
              class="inline-block rounded bg-blue-700 px-4 py-2 font-medium text-white hover:bg-blue-800"
            >
              Continue
            </a>
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
