# Admin Basic Auth credentials (required). Never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Path to the SQLite database file.
DATABASE_PATH=./data/playground.db

# Store client IP addresses on tracked events (true/false).
TRACK_IP=true

# HTTP status returned for a disabled public test page (410 or 404).
DISABLED_STATUS=410

# make site invite only
INVITE_GATE_ENABLED=false
INVITE_CODES=invite-demo-1,invite-demo-2

